{
  "name": "eve-content-agent-template",
  "version": "0.0.0",
  "private": true,
  "description": "A Slack-based content assistant on eve that drafts blog posts, LinkedIn and X posts, release notes, and newsletters in your house voice from Notion source material.",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "prebuild": "node scripts/sync-shared.mjs",
    "build": "eve build",
    "check": "ultracite check",
    "predev": "node scripts/sync-shared.mjs",
    "dev": "eve dev",
    "fix": "ultracite fix",
    "start": "eve start",
    "sync:shared": "node scripts/sync-shared.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@vercel/blob": "2.7.0",
    "@vercel/connect": "0.6.1",
    "ai": "7.0.58",
    "eve": "0.31.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.2.0",
    "microsandbox": "0.5.10",
    "typescript": "7.0.2",
    "ultracite": "7.10.2"
  },
  "engines": {
    "node": ">=24"
  }
}
